# Copia este archivo como .env y pon tus claves de Alpaca.
# Las claves se crean en https://app.alpaca.markets  (sección "API Keys" de la cuenta Paper).
# NUNCA subas el archivo .env a GitHub.
ALPACA_API_KEY=tu_api_key
ALPACA_SECRET_KEY=tu_secret_key

# true = cuenta de papel (dinero ficticio). Déjalo así hasta estar muy seguro.
ALPACA_PAPER=true

# Solo si ALPACA_PAPER=false: escribe SI para confirmar que quieres usar dinero real.
CONFIRMO_DINERO_REAL=
